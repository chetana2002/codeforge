# =============================================================================
# CodeForge environment configuration
# Copy this file to .env and adjust values for your machine.
# Never commit the real .env file.
# =============================================================================

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=codeforge
POSTGRES_PASSWORD=codeforge_dev_password
POSTGRES_DB=codeforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://codeforge:codeforge_dev_password@postgres:5432/codeforge
# Host-side published port (container-internal port is always 5432).
# Changed from the Postgres default of 5432 to avoid clashing with other local projects.
POSTGRES_PORT_HOST=5435

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
# Host-side published port (container-internal port is always 6379).
REDIS_PORT_HOST=6381

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-64-byte-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# --- CORS ---
CORS_ORIGINS=http://localhost:3002,http://localhost:3000

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Host-side published port for the API container (avoids clashing with other local projects).
API_PORT_HOST=8001
FRONTEND_PORT_HOST=3002
PROMETHEUS_PORT_HOST=9091
GRAFANA_PORT_HOST=3003

# --- Execution sandbox ---
EXECUTION_TIMEOUT_SECONDS=10
EXECUTION_MEMORY_LIMIT_MB=128
EXECUTION_CPU_LIMIT=0.5
EXECUTION_PIDS_LIMIT=64
DOCKER_SOCKET=/var/run/docker.sock

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_EXECUTION_PER_MINUTE=20
RATE_LIMIT_PROJECT_CREATE_PER_MINUTE=20

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
# Deliberately not set: prometheus_client checks only whether this key is
# PRESENT in the environment (any value, including empty) to decide whether
# to activate multiprocess mode — see backend/app/core/metrics.py. This app
# runs one process per container (no gunicorn/pre-fork workers), so
# multiprocess mode is both unneeded and actively wrong here: it would write
# per-PID mmap files to disk on every metric update instead of just keeping
# counters in memory. Uncomment and point it at a writable directory only if
# this ever moves to a multi-worker deployment model.
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus-multiproc

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8001
